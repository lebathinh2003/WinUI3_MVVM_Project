<Page
    x:Class="WinUI3_MVVM_Project.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI3_MVVM_Project.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WinUI3_MVVM_Project.ViewModels"
    mc:Ignorable="d">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="300">
        <StackPanel Spacing="10" Padding="20">
            <TextBlock Text="Đăng nhập" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Tên đăng nhập:"/>
            <TextBox x:Name="UsernameTextBox"
                     Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Nhập tên đăng nhập"/>

            <TextBlock Text="Mật khẩu:"/>
            <PasswordBox x:Name="PasswordBox"
                         Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Nhập mật khẩu"
                         PasswordRevealMode="Peek"/>

            <TextBlock x:Name="ErrorMessageTextBlock"
                       Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                       Foreground="Red"
                       Visibility="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0"/>

            <Button x:Name="LoginButton"
                    Content="Đăng nhập"
                    Command="{x:Bind ViewModel.ExecuteLoginCommand}"
                    HorizontalAlignment="Stretch"
                    Margin="0,20,0,0"
                    Style="{StaticResource AccentButtonStyle}">
            </Button>

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          HorizontalAlignment="Center"
                          Margin="0,10,0,0"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
        </StackPanel>
    </Grid>
</Page>
