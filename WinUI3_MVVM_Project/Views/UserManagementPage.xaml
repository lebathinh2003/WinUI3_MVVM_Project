<Page
    x:Class="WinUI3_MVVM_Project.Views.UserManagementPage"
    x:Name="UserManagementPageRoot"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:WinUI3_MVVM_Project.Views"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:viewmodels="using:WinUI3_MVVM_Project.ViewModels"
	xmlns:models="using:WinUI3_MVVM_Project.Models"
	xmlns:converters="using:WinUI3_MVVM_Project.Converters"
	xmlns:controls="using:WinUI3_MVVM_Project.Controls" 
    xmlns:helpers="using:WinUI3_MVVM_Project.Helpers"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:StringFormatConverter x:Key="StringFormatConverter"/>
    </Page.Resources>
    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Quản lý người dùng" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Style="{StaticResource AddButtonStyle}"
                    Content="Thêm người dùng"
                    VerticalAlignment="Center"/>
        </Grid>
        <ProgressRing Grid.Row="1"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Margin="0,10,0,10"/>
        <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=True}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="20,20,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="40" Width="1*"/>
                    <ColumnDefinition MinWidth="40" Width="1*"/>
                    <ColumnDefinition MinWidth="120" Width="3*"/>
                    <ColumnDefinition MinWidth="80" Width="2*"/>
                    <ColumnDefinition MinWidth="280" Width="3*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderThickness="1,1,1,1" BorderBrush="Gray" Padding="4">
                    <TextBlock Text="" FontWeight="Bold"/>
                </Border>
                <Border Grid.Column="1" BorderThickness="0,1,1,1" BorderBrush="Gray" Padding="4">
                    <TextBlock Text="ID" FontWeight="Bold"/>
                </Border>
                <Border Grid.Column="2" BorderThickness="0,1,1,1" BorderBrush="Gray" Padding="4">
                    <TextBlock Text="Email" FontWeight="Bold"/>
                </Border>
                <Border Grid.Column="3" BorderThickness="0,1,1,1" BorderBrush="Gray" Padding="4">
                    <TextBlock Text="Full Name and Username" FontWeight="Bold"/>
                </Border>
                <Border Grid.Column="4" BorderThickness="0,1,1,1" BorderBrush="Gray" Padding="4">
                    <TextBlock Text="Action" FontWeight="Bold"/>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="20,0,20,0" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Users}"
                               helpers:SelectableRepeaterBehavior.IsEnabled="True"
                               helpers:SelectableRepeaterBehavior.ItemTappedCommand="{x:Bind ViewModel.SelectUserCommand}"
                               helpers:SelectableRepeaterBehavior.SelectedItem="{x:Bind ViewModel.SelectedUser, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="0"/>
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:User">
                            <Grid Background="Transparent"
                                  DataContext="{Binding}"
                                  helpers:GridColumnSyncHelper.SyncWith="{Binding ElementName=HeaderGrid}">
                                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1,0,1,1" Padding="8">
                                    <FontIcon />
                                </Border>
                                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="0,0,1,1" Padding="8">
                                    <TextBlock Text="{x:Bind Id}" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="2"
                                        BorderBrush="Gray" 
                                        BorderThickness="0,0,1,1" 
                                        Padding="8"
                                        Background="Transparent"
                                        helpers:CustomPopupBehavior.IsEnabled="True"
                                        >
                                    <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{x:Bind Email}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="3" BorderBrush="Gray" BorderThickness="0,0,1,1" Padding="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Bind FullName}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind Username}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" BorderBrush="Gray" BorderThickness="0,0,1,1" Padding="8">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Style="{StaticResource AddButtonStyle}" Content="Add"/>
                                        <Button Style="{StaticResource EditButtonStyle}" Content="Edit"/>
                                        <Button Style="{StaticResource DeleteButtonStyle}" Content="Delete"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <TextBlock Grid.Row="1"
               Text="Không có người dùng nào để hiển thị."
               Visibility="{x:Bind ViewModel.Users.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=True}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               FontStyle="Italic"
               Margin="0,20,0,0"/>
        </Grid>
        <controls:TablePaginateControl Grid.Row="3"
                                       ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom" 
                                       Margin="0,10,0,10"
                                       Visibility="{x:Bind ViewModel.Users.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}"/>
    </Grid>
</Page>