<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="TableItemBorderedBackgroundColor" Color="#F9F9F9"/>
            <SolidColorBrush x:Key="TableItemBorderedForegroundColor" Color="#202020"/>

            <SolidColorBrush x:Key="TableItemBorderedBackgroundColor_Overed" Color="#EFEFEF"/>
            <SolidColorBrush x:Key="TableItemBorderedForegroundColor_Overed" Color="#202020"/>

            <SolidColorBrush x:Key="TableItemBorderedBackgroundColor_Selected" Color="#CDE8FF"/>
            <SolidColorBrush x:Key="TableItemBorderedForegroundColor_Selected" Color="#004A7F"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TableItemBorderedBackgroundColor" Color="#F9F9F9"/>
            <SolidColorBrush x:Key="TableItemBorderedForegroundColor" Color="#202020"/>

            <SolidColorBrush x:Key="TableItemBorderedBackgroundColor_Overed" Color="#EFEFEF"/>
            <SolidColorBrush x:Key="TableItemBorderedForegroundColor_Overed" Color="#202020"/>

            <SolidColorBrush x:Key="TableItemBorderedBackgroundColor_Selected" Color="#CDE8FF"/>
            <SolidColorBrush x:Key="TableItemBorderedForegroundColor_Selected" Color="#004A7F"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="TableItemBorderedBackgroundColor" Color="#202020"/>
            <SolidColorBrush x:Key="TableItemBorderedForegroundColor" Color="#E1E1E1"/>

            <SolidColorBrush x:Key="TableItemBorderedBackgroundColor_Overed" Color="#333333"/>
            <SolidColorBrush x:Key="TableItemBorderedForegroundColor_Overed" Color="#E1E1E1"/>

            <SolidColorBrush x:Key="TableItemBorderedBackgroundColor_Selected" Color="#285374"/>
            <SolidColorBrush x:Key="TableItemBorderedForegroundColor_Selected" Color="#CDE8FF"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
